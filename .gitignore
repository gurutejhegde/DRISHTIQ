# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Ruff / Linting / Testing caches
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Video artifacts & data storage (keep skeleton with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/chunks/*
!data/chunks/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
data/logs/*
!data/logs/.gitkeep

# IDEs & Editors
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Keep .vscode configuration committed for team alignment
!.vscode/settings.json
!.vscode/extensions.json
